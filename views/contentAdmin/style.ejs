<style>
  * { box-sizing: border-box; }
  body { margin: 0; background: #141514; color: #fff; font-family: -apple-system, 'Segoe UI', Roboto, sans-serif; padding: 40px 16px; }
  .wrap { max-width: 860px; margin: 0 auto; }
  h1 { font-size: 26px; margin: 0 0 4px; }
  p.subtitle { color: #8A8D90; margin: 0 0 24px; line-height: 1.5; }
  h2 { font-size: 15px; color: #8A8D90; text-transform: uppercase; letter-spacing: .5px; margin: 32px 0 10px; }
  .banner { background: #3BB27322; border: 1px solid #3BB27355; color: #3BB273; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 14px; }
  .banner.error { background: #E8483D22; border-color: #E8483D55; color: #E8483D; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
  a.item { display: block; background: #1C1D1C; border: 1px solid #2E302F; border-radius: 14px; overflow: hidden; color: #fff; text-decoration: none; }
  a.item:hover { border-color: #D6362F; }
  .thumb { height: 130px; background: #222 center/cover no-repeat; display: flex; align-items: center; justify-content: center; color: #555; font-size: 13px; }
  .item .body { padding: 12px 14px; }
  .item .name { font-weight: 700; }
  .item .desc { color: #8A8D90; font-size: 13px; margin-top: 4px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tag { display: inline-block; font-size: 11px; font-weight: 700; color: #8A8D90; background: #2E302F; border-radius: 999px; padding: 2px 8px; margin-top: 8px; }
  .tag.missing { color: #F2A93B; background: #F2A93B22; }
  label { display: block; color: #8A8D90; font-size: 13px; font-weight: 600; margin: 20px 0 6px; }
  textarea { width: 100%; min-height: 120px; background: #1C1D1C; border: 1px solid #2E302F; border-radius: 10px; padding: 12px 14px; color: #fff; font: 15px/1.5 inherit; resize: vertical; }
  .preview { width: 100%; max-height: 340px; object-fit: cover; border-radius: 12px; display: block; background: #222; }
  .empty-photo { height: 160px; border: 2px dashed #2E302F; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #8A8D90; font-size: 14px; }
  .row { display: flex; align-items: center; gap: 8px; margin-top: 10px; color: #fff; font-size: 14px; }
  input[type=file] { color: #8A8D90; margin-top: 10px; }
  button { margin-top: 26px; width: 100%; padding: 15px; border: none; border-radius: 999px; background: #D6362F; color: #fff; font-size: 16px; font-weight: 700; cursor: pointer; }
  button:disabled { opacity: .6; cursor: wait; }
  .hint { color: #8A8D90; font-size: 13px; margin-top: 6px; line-height: 1.4; }
</style>
