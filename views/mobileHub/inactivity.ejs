<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inactivity Reminders — Carbon</title>
  <style>
    body { margin: 0; background: #141514; color: #fff; font-family: -apple-system, 'Segoe UI', Roboto, sans-serif; padding: 40px 16px; }
    .wrap { max-width: 860px; margin: 0 auto; }
    h1 { font-size: 26px; margin: 0 0 4px; }
    p.subtitle { color: #8A8D90; margin: 0 0 24px; line-height: 1.5; }
    .banner { background: #3BB27322; border: 1px solid #3BB27355; color: #3BB273; border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; font-size: 14px; }
    .banner.none { background: #1C1D1C; border-color: #2E302F; color: #8A8D90; }
    form button { background: #D6362F; color: #fff; border: 0; border-radius: 999px; padding: 12px 22px; font-size: 15px; font-weight: 700; cursor: pointer; }
    form button:hover { background: #b82e28; }
    h2 { font-size: 15px; color: #8A8D90; text-transform: uppercase; letter-spacing: .5px; margin: 32px 0 10px; }
    .table-wrap { overflow-x: auto; background: #1C1D1C; border: 1px solid #2E302F; border-radius: 12px; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 560px; }
    th { text-align: left; color: #8A8D90; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .4px; padding: 12px 14px; border-bottom: 1px solid #2E302F; }
    td { padding: 12px 14px; border-bottom: 1px solid #2E302F; }
    tr:last-child td { border-bottom: 0; }
    .muted { color: #8A8D90; }
    .pill { display: inline-block; font-size: 12px; font-weight: 700; border-radius: 999px; padding: 3px 10px; }
    .pill.yes { color: #3BB273; background: #3BB27322; }
    .pill.no { color: #F2A93B; background: #F2A93B22; }
    .empty { color: #8A8D90; padding: 18px; }
    a.phone { color: #fff; }
  </style>
</head>
<body>
  <div class="wrap">
    <%- include('backLink') %>
    <h1>Inactivity Reminders</h1>
    <p class="subtitle">
      Every day at 9am, members with an active package who haven't checked in for <%= INACTIVE_AFTER_DAYS %>+ days
      get a push reminder. Each member gets at most one reminder every <%= REMIND_COOLDOWN_DAYS %> days.
    </p>

    <% const fmt = (d) => d ? new Date(d).toLocaleString('en-GB', { timeZone: 'Africa/Cairo', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : null; %>
    <% const table = (list, showSent) => { %>
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>Member</th><th>Phone</th><th>Last check-in</th><% if (showSent) { %><th>Reminded</th><% } %><th>Push delivered</th>
          </tr></thead>
          <tbody>
            <% list.forEach(function (m) { %>
              <tr>
                <td><%= m.first_name %> <%= m.last_name || '' %> <span class="muted">#<%= m.id %></span></td>
                <td><% if (m.phone_number) { %><a class="phone" href="tel:<%= m.phone_number %>"><%= m.phone_number %></a><% } else { %><span class="muted">—</span><% } %></td>
                <td><%= fmt(m.last_attendance) || 'Never' %></td>
                <% if (showSent) { %><td><%= fmt(m.last_sent_at) %></td><% } %>
                <td><% if (m.has_app) { %><span class="pill yes">Sent to app</span><% } else { %><span class="pill no">No app — call instead</span><% } %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% }; %>

    <% if (justSent) { %>
      <% if (justSent.length) { %>
        <div class="banner">✓ Check complete — <%= justSent.length %> member(s) reminded just now.</div>
        <h2>Reminded just now</h2>
        <% table(justSent, false); %>
      <% } else { %>
        <div class="banner none">Check complete — nobody new to remind. Everyone inactive was already reminded in the last <%= REMIND_COOLDOWN_DAYS %> days.</div>
      <% } %>
    <% } %>

    <form method="POST" action="/admin-tools/run-inactivity-check" style="margin-top:8px;">
      <button type="submit">Run check now</button>
    </form>

    <h2>Reminded in the last <%= REMIND_COOLDOWN_DAYS %> days</h2>
    <% if (recent.length) { table(recent, true); } else { %>
      <div class="table-wrap"><div class="empty">No reminders sent in the last <%= REMIND_COOLDOWN_DAYS %> days.</div></div>
    <% } %>
  </div>
</body>
</html>
