<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Carbon — Payment</title>
  <style>
    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #141514; color: #fff; font-family: -apple-system, 'Segoe UI', Roboto, sans-serif; padding: 24px; box-sizing: border-box; text-align: center; }
    .icon { font-size: 56px; }
    h1 { font-size: 24px; margin: 16px 0 8px; }
    p { color: #b5b8bb; font-size: 16px; line-height: 1.5; max-width: 340px; margin: 0 auto; }
    .hint { margin-top: 24px; color: #8A8D90; font-size: 14px; }
  </style>
</head>
<body>
  <div>
    <% if (outcome === 'paid') { %>
      <div class="icon">✅</div>
      <h1>Payment successful</h1>
      <p>Your package is being activated.</p>
    <% } else if (outcome === 'failed') { %>
      <div class="icon">⚠️</div>
      <h1>Payment didn't go through</h1>
      <p>Nothing was charged. You can try again from the app.</p>
    <% } else { %>
      <div class="icon">⏳</div>
      <h1>Checking your payment…</h1>
      <p>The Carbon app will show the result in a moment.</p>
    <% } %>
    <p class="hint">Tap <strong>Done</strong> or <strong>✕</strong> at the top to return to Carbon.</p>
  </div>
</body>
</html>
