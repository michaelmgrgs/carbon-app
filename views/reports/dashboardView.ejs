            // Call the function to render the traffic charts on page load
            renderInitialTrafficCharts(defaultBranch, defaultMonth, defaultYear);


            // Set the selected attribute for the current month in the dropdown
            $('#monthDropdown').val(defaultMonth);

            // Handle branch selection change for traffic charts
            $('#branchDropdown').on('change', function () {
                const selectedBranch = $(this).val();
                const selectedMonth = $('#monthDropdown').val();
                const selectedYear = $('#yearDropdown').val();
                getTrafficSummary(selectedBranch, selectedMonth, selectedYear)
                    .then(data => renderTrafficCharts(data))
                    .catch(error => console.error('Error fetching and rendering traffic data:', error));
            });

            // Handle month selection change for traffic charts
            $('#monthDropdown').on('change', function () {
                const selectedMonth = $(this).val();
                const selectedBranch = $('#branchDropdown').val();
                const selectedYear = $('#yearDropdown').val();
                getTrafficSummary(selectedBranch, selectedMonth, selectedYear)
                    .then(data => renderTrafficCharts(data))
                    .catch(error => console.error('Error fetching and rendering traffic data:', error));
            });

            // Handle year selection change for traffic charts
            $('#yearDropdown').on('change', function () {
                const selectedYear = $(this).val();
                const selectedBranch = $('#branchDropdown').val();
                const selectedMonth = $('#monthDropdown').val();
                getTrafficSummary(selectedBranch, selectedMonth, selectedYear)
                    .then(data => renderTrafficCharts(data))
                    .catch(error => console.error('Error fetching and rendering traffic data:', error));
            });

        });
