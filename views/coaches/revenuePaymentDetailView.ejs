<%- include('../includes/header') %>
<title>Coach Payment Details</title>
<link rel="stylesheet" href="/node_modules/bootstrap/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="main-container">
        <%- include('../includes/sideNav') %>
        <div class="content-container">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1>Payment Details</h1>
                    <a href="/coaches/revenue-payments/branch/<%= branchName %>?month=<%= moment(payment.payment_period).format('M') %>&year=<%= moment(payment.payment_period).format('YYYY') %>" class="btn btn-secondary">Back to Dashboard</a>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><h5>Summary for <%= payment.first_name %> <%= payment.last_name %></h5></div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Period:</strong> <%= moment(payment.payment_period).format('MMMM YYYY') %></p>
                                <p><strong>Branch:</strong> <%= payment.branch_name %></p>
                                <p><strong>Total Revenue Generated by Coach:</strong> $<%= parseFloat(payment.total_revenue_generated).toFixed(2) %></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Average Commission:</strong> <%= parseFloat(payment.average_commission_percentage).toFixed(1) %>%</p>
                                <p><strong>Total Earnings:</strong> <strong class="fs-5">$<%= parseFloat(payment.total_earnings).toFixed(2) %></strong></p>
                                <p><strong>Status:</strong> <span class="badge <%= payment.payment_status === 'pending' ? 'bg-warning' : payment.payment_status === 'paid' ? 'bg-success' : 'bg-primary' %>"><%= payment.payment_status %></span></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header"><h5>Class by Class Breakdown</h5></div>
                    <div class="card-body">
                        <% if (!payment.class_details || payment.class_details.length === 0) { %>
                            <p class="text-center">No class details found for this payment period.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Class Date</th>
                                            <th>Class Name</th>
                                            <th>Attendees</th>
                                            <th>Class Revenue</th>
                                            <th>Commission Rate</th>
                                            <th>Coach Earning</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% payment.class_details.sort((a, b) => new Date(a.classDate) - new Date(b.classDate)).forEach(detail => { %>
                                            <tr>
                                                <td><%= moment(detail.classDate).format('YYYY-MM-DD') %></td>
                                                <td><%= detail.className %></td>
                                                <td><%= detail.attendeeCount %></td>
                                                <td>$<%= parseFloat(detail.classRevenue).toFixed(2) %></td>
                                                <td><%= detail.commissionRate %>%</td>
                                                <td>$<%= parseFloat(detail.coachEarning).toFixed(2) %></td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>