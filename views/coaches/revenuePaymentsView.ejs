<%- include('../includes/header') %>
<title>Coach Revenue Payments</title>
<link rel="stylesheet" href="/node_modules/bootstrap/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="main-container">
        <%- include('../includes/sideNav') %>
        <div class="content-container">
            <div class="container mt-4">
                <h1>Coach Revenue Payments</h1>
                
                <div class="card mb-4">
                    <div class="card-header">
                        <form id="filterForm" class="row g-3 align-items-center">
                            <div class="col-md-auto"><h5 class="mb-0">Dashboard for <%= selectedBranch %></h5></div>
                            <div class="col-md">
                                <div class="d-flex justify-content-end">
                                    <div class="me-2">
                                        <select class="form-select" id="month" name="month">
                                            <% for(let i = 1; i <= 12; i++) { %><option value="<%= i %>" <%= selectedMonth === i ? 'selected' : '' %>><%= moment().month(i-1).format('MMMM') %></option><% } %>
                                        </select>
                                    </div>
                                    <div class="me-2">
                                        <select class="form-select" id="year" name="year">
                                            <% for(let i = moment().year() - 2; i <= moment().year() + 1; i++) { %><option value="<%= i %>" <%= selectedYear === i ? 'selected' : '' %>><%= i %></option><% } %>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Filter</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-end align-items-center mb-3">
                            <button type="button" class="btn btn-success" id="calculatePaymentsBtn">Calculate All Payments for this Month</button>
                        </div>
                        
                        <% if (payments.length === 0) { %>
                            <p class="text-center">No payment records found. Click "Calculate Payments" to generate them.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Coach</th>
                                            <th>Total Revenue Generated</th>
                                            <th>Avg. Commission</th>
                                            <th>Total Earnings</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% payments.forEach(payment => { %>
                                            <tr>
                                                <td><%= payment.first_name %> <%= payment.last_name %></td>
                                                <td>$<%= parseFloat(payment.total_revenue_generated).toFixed(2) %></td>
                                                <td><%= parseFloat(payment.average_commission_percentage).toFixed(1) %>%</td>
                                                <td><strong>$<%= parseFloat(payment.total_earnings).toFixed(2) %></strong></td>
                                                <td><span class="badge <%= payment.payment_status === 'pending' ? 'bg-warning' : payment.payment_status === 'paid' ? 'bg-success' : 'bg-primary' %>"><%= payment.payment_status %></span></td>
                                                <td>
                                                    <a href="/coaches/revenue-payments/branch/<%= selectedBranch %>/details/<%= payment.payment_id %>" class="btn btn-sm btn-info">Details</a>
                                                    <button class="btn btn-sm btn-primary update-status" data-payment-id="<%= payment.payment_id %>" data-coach-name="<%= payment.first_name %> <%= payment.last_name %>" data-status="<%= payment.payment_status %>" data-payment-date="<%= payment.payment_date ? moment(payment.payment_date).format('YYYY-MM-DD') : '' %>" data-notes="<%= payment.notes || '' %>">Update Status</button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <!-- Update Status Modal -->
            <div class="modal fade" id="updateStatusModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Update Payment Status</h5></div><div class="modal-body"><form id="updateStatusForm"><input type="hidden" id="payment_id" name="payment_id"><p>Updating payment for: <strong id="status_coach_name"></strong></p><div class="mb-3"><label for="payment_status" class="form-label">Status</label><select class="form-select" id="payment_status" name="payment_status" required><option value="pending">Pending</option><option value="approved">Approved</option><option value="paid">Paid</option><option value="cancelled">Cancelled</option></select></div><div class="mb-3"><label for="payment_date" class="form-label">Payment Date</label><input type="date" class="form-control" id="payment_date" name="payment_date"></div><div class="mb-3"><label for="status_notes" class="form-label">Notes</label><textarea class="form-control" id="status_notes" name="notes" rows="3"></textarea></div></form></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="saveStatusBtn">Update Status</button></div></div></div></div>
        </div>
    </div>
    
    <script src="/node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const branchName = "<%= selectedBranch %>";
            document.getElementById('filterForm').addEventListener('submit', function(e) {
                e.preventDefault();
                window.location.href = `/coaches/revenue-payments/branch/${branchName}?month=${this.month.value}&year=${this.year.value}`;
            });

            document.getElementById('calculatePaymentsBtn').addEventListener('click', function() {
                if (!confirm('This will recalculate all payments for the selected month, overwriting any existing data. Continue?')) return;
                this.disabled = true; this.textContent = 'Calculating...';
                fetch(`/coaches/revenue-payments/branch/${branchName}/calculate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ month: document.getElementById('month').value, year: document.getElementById('year').value })
                }).then(res => res.json()).then(data => {
                    alert(data.success ? `${data.message}` : `Error: ${data.message}`);
                    if(data.success) location.reload(); else { this.disabled = false; this.textContent = 'Calculate All Payments'; }
                }).catch(err => { alert('A critical error occurred.'); this.disabled = false; this.textContent = 'Calculate All Payments'; });
            });

            const updateStatusModal = new bootstrap.Modal(document.getElementById('updateStatusModal'));
            document.querySelectorAll('.update-status').forEach(button => {
                button.addEventListener('click', function () {
                    const form = document.getElementById('updateStatusForm');
                    form.querySelector('#payment_id').value = this.dataset.paymentId;
                    form.querySelector('#status_coach_name').textContent = this.dataset.coachName;
                    form.querySelector('#payment_status').value = this.dataset.status;
                    form.querySelector('#payment_date').value = this.dataset.paymentDate;
                    form.querySelector('#status_notes').value = this.dataset.notes;
                    updateStatusModal.show();
                });
            });

            document.getElementById('saveStatusBtn').addEventListener('click', function () {
                const form = document.getElementById('updateStatusForm');
                const paymentId = form.querySelector('#payment_id').value;
                const data = {
                    payment_status: form.querySelector('#payment_status').value,
                    payment_date: form.querySelector('#payment_date').value,
                    notes: form.querySelector('#status_notes').value
                };
                if (data.payment_status === 'paid' && !data.payment_date) return alert('Payment Date is required for "Paid" status.');
                fetch(`/coaches/revenue-payments/branch/${branchName}/${paymentId}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                }).then(res => res.json()).then(result => {
                    alert(result.success ? 'Status updated!' : `Error: ${result.message}`);
                    if(result.success) location.reload();
                });
            });
        });
    </script>
</body>
</html>
