<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Carbon Check-In — <%= branchName %></title>
  <style>
    body {
      margin: 0; height: 100vh; display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      background: radial-gradient(circle at center, #202221 0%, #141514 100%);
      font-family: -apple-system, 'Segoe UI', Roboto, sans-serif; color: #fff;
    }
    .card {
      background: #1c1d1c; border: 1px solid #2e302f; border-radius: 24px;
      padding: 48px 64px; text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    h1 { font-size: 28px; margin: 0 0 4px; letter-spacing: 1px; }
    .branch { color: #D6362F; font-weight: 700; }
    p.subtitle { color: #8A8D90; margin-top: 0; margin-bottom: 28px; }
    #qr-wrap {
      width: 340px; height: 340px; background: #fff; border-radius: 16px;
      display: flex; align-items: center; justify-content: center; margin: 0 auto;
      padding: 16px; box-sizing: border-box;
    }
    #qr-wrap img { width: 100%; height: 100%; }
    .bar { height: 4px; width: 340px; background: #2e302f; border-radius: 4px; margin-top: 20px; overflow: hidden; }
    .bar-fill { height: 100%; background: #D6362F; width: 100%; transition: width linear; }
    .hint { margin-top: 20px; color: #8A8D90; font-size: 14px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Scan to check in — <span class="branch"><%= branchName %></span></h1>
    <p class="subtitle">Open the Carbon app and tap "Scan" on the Attendance tab</p>
    <div id="qr-wrap"><img id="qr-img" alt="QR code" /></div>
    <div class="bar"><div class="bar-fill" id="bar-fill"></div></div>
    <p class="hint">This code refreshes automatically for security</p>
  </div>

  <script>
    const branchName = <%- JSON.stringify(branchName) %>;
    const refreshMs = <%- refreshMs %>;

    async function loadQR() {
      const res = await fetch(`/attendance/desk/${encodeURIComponent(branchName)}/qr-image`);
      const data = await res.json();
      document.getElementById('qr-img').src = data.dataUrl;

      const fill = document.getElementById('bar-fill');
      fill.style.transition = 'none';
      fill.style.width = '100%';
      requestAnimationFrame(() => {
        fill.style.transition = `width ${refreshMs}ms linear`;
        fill.style.width = '0%';
      });
    }

    loadQR();
    setInterval(loadQR, refreshMs);
  </script>
</body>
</html>
