<%- include('../includes/header') %>
<title>Attendance Details</title>
</head>

<body>
<div class="main-container">
    <%- include('../includes/sideNav') %>

    <div class="content-container">
        <div class="user-listing">
            <h1>Attendance Details</h1>

            <div class="filters-container attendance-view">
                <div>
                    <input type="text" id="datepicker">
                </div>
                <div>
                    <select id="branchDropdown">
                        <option value="all">All Branches</option>
                    </select>
                </div>
                <div>
                    <button type="button" id="filterButton">Filter</button>
                </div>
            </div>

            <div id="attendanceTableDetails">
                <table class="attendance-table" id="attendanceTable">
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>User Name</th>
                            <th>Package</th>
                            <th>Branch Name</th>
                            <th>Class Name / Time</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% attendanceDetails.forEach(attendance => { %>
                            <tr>
                                <td><%= attendance.user_id %></td>
                                <td><%= attendance.user_name %></td>
                                <td><%= attendance.package_name %></td>
                                <td><%= attendance.branch_name %></td>
                                <td><%= attendance.class_name || '-' %></td>
                                <td>
                                    <button
                                        class="btn btn-danger btn-sm delete-attendance"
                                        data-id="<%= attendance.attendance_id %>">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Loader -->
    <div class="loader" id="loader" style="display:none;"></div>
    <div class="screen-fade" id="screenFade" style="display:none;"></div>
</div>

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script src="/node_modules/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>

<script>
/* ===============================
   GLOBAL LOADER FUNCTIONS
================================ */
function showLoader() {
    $('#loader').show();
    $('#screenFade').show();
}

function hideLoader() {
    $('#loader').hide();
    $('#screenFade').hide();
}

/* ===============================
   DELETE ATTENDANCE
================================ */
$(document).on('click', '.delete-attendance', function () {
    const attendanceId = $(this).data('id');

    if (!confirm('Are you sure you want to delete this attendance record?')) {
        return;
    }

    showLoader();

    $.ajax({
        url: `/attendanceDetails/delete/${attendanceId}`,
        method: 'DELETE',
        success: function (response) {
            hideLoader();
            alert(response.message || 'Record deleted');
            filterData();
        },
        error: function (error) {
            hideLoader();
            console.error('Delete failed:', error);
            alert('Failed to delete record');
        }
    });
});

/* ===============================
   DOCUMENT READY
================================ */
$(document).ready(function () {

    /* ---------- Datepicker ---------- */
    $('#datepicker').datepicker({
        todayHighlight: true,
        format: 'dd-mm-yyyy',
        autoclose: true
    });

    /* ---------- Load Branches ---------- */
    function getAvailableBranches() {
        return $.ajax({
            url: '/attendanceDetails/all/availableBranches',
            method: 'GET'
        });
    }

    function populateBranchDropdown() {
        getAvailableBranches()
            .then(data => {
                const dropdown = $('#branchDropdown');
                dropdown.empty();
                dropdown.append(`<option value="all">All Branches</option>`);

                data.forEach(b => {
                    dropdown.append(`<option value="${b.branch_name}">${b.branch_name}</option>`);
                });
            })
            .catch(err => console.error(err));
    }

    populateBranchDropdown();

    /* ---------- Filter Button ---------- */
    $('#filterButton').on('click', function () {
        showLoader();
        filterData();
    });

    /* ---------- Fetch & Filter ---------- */
    function filterData() {
        const date = $('#datepicker').val();
        const branch = $('#branchDropdown').val();

        $.ajax({
            url: '/attendanceDetails/all/attendanceDetails',
            method: 'GET',
            data: { date, branch },
            success: function (data) {
                hideLoader();
                updateTable(data);
            },
            error: function (error) {
                hideLoader();
                console.error('Filter error:', error);
            }
        });
    }

    /* ---------- Update Table ---------- */
    function updateTable(data) {
        const tbody = $('#attendanceTable tbody');
        tbody.empty();

        if (!data.length) {
            tbody.append(`
                <tr>
                    <td colspan="6" style="text-align:center;">No records found</td>
                </tr>
            `);
            return;
        }

        data.forEach(attendance => {
            tbody.append(`
                <tr>
                    <td>${attendance.user_id}</td>
                    <td>${attendance.user_name}</td>
                    <td>${attendance.package_name}</td>
                    <td>${attendance.branch_name}</td>
                    <td>${attendance.class_name || '-'}</td>
                    <td>
                        <button 
                            class="btn btn-danger btn-sm delete-attendance"
                            data-id="${attendance.attendance_id}">
                            Delete
                        </button>
                    </td>
                </tr>
            `);
        });
    }

});
</script>
</body>
</html>